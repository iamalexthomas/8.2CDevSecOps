// Part 2 Task 1: keep the npm pipeline and add SonarCloud analysis.
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    triggers {
        pollSCM('* * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/iamalexthomas/8.2CDevSecOps.git'
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        stage('Run Tests') {
            steps {
                sh 'npm test || true'
            }
        }
        stage('Generate Coverage Report') {
            steps {
                // The supplied project has no coverage script; keep its error visible.
                sh 'npm run coverage || true'
            }
        }
        stage('NPM Audit (Security Scan)') {
            steps {
                sh 'npm audit || true'
            }
        }
        stage('SonarCloud Analysis') {
            steps {
                withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set +x
                        set -eu
                        mkdir -p .sonar-tools
                        scanner=sonar-scanner-8.1.0.6389-linux-x64
                        if [ ! -x ".sonar-tools/$scanner/bin/sonar-scanner" ]; then
                            curl --fail --location --retry 3 \\
                                https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-8.1.0.6389-linux-x64.zip \\
                                --output .sonar-tools/scanner.zip
                            unzip -q -o .sonar-tools/scanner.zip -d .sonar-tools
                        fi
                        # The scanner reads SONAR_TOKEN from the environment.
                        ".sonar-tools/$scanner/bin/sonar-scanner"
                        python3 sonar-results.py
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'sonar-results/*.json,.scannerwork/report-task.txt', allowEmptyArchive: true
        }
    }
}
